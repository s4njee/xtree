{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "playwright.config.ts",
    "packages/xtree/test/browser/**/*.ts",
    "packages/xtree/test/fixtures/**/*.ts",
    "packages/xtree/src/glsl-modules.d.ts",
    "packages/xtree/src/holocss/holocss-runtime.d.ts",
    "playwright.docs.config.ts",
    "docs/tests/**/*.ts"
  ]
}
